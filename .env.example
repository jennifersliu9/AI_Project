# Copy this file to .env and fill in values locally.
# Never commit .env or real API keys.

# Required for the default pinecone backend (text-embedding-3-small) and for
# LLM-written answers. A key saved only in Cursor Settings → Models is not
# visible to this process.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Azure / compatible endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1

# Reproducibility
HARBORLINE_SEED=42

# Retrieval / chunking (deterministic; no random split)
HARBORLINE_CHUNK_SIZE=900
HARBORLINE_CHUNK_OVERLAP=120
HARBORLINE_TOP_K=5

# pinecone (default): OpenAI embeddings + a hosted Pinecone index.
# The process does not download sentence-transformer weights or keep the
# index in memory. tfidf is offline lexical search and needs no API keys
# (pytest and CI use it).
HARBORLINE_RETRIEVE_BACKEND=pinecone
HARBORLINE_EMBEDDING_MODEL=text-embedding-3-small

# Hosted vector index. Required when HARBORLINE_RETRIEVE_BACKEND=pinecone.
# Create a cosine index with dimension 1536 (text-embedding-3-small).
# Set PINECONE_INDEX_HOST, or set PINECONE_INDEX_NAME and the app resolves it.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
# PINECONE_INDEX_NAME=harborline
PINECONE_NAMESPACE=harborline
HARBORLINE_REWRITE=true
HARBORLINE_RERANK=true
HARBORLINE_FETCH_K=20
HARBORLINE_MIN_SCORE=0.22

# Leave unset to use llm when OPENAI_API_KEY is set, otherwise retrieve.
# Set retrieve to keep extractive templates even if a key is present.
# HARBORLINE_ANSWER_MODE=retrieve
