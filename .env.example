# Copy this file to .env and fill in values locally.
# Never commit .env or real API keys.

# When this is set and HARBORLINE_ANSWER_MODE is unset, answers use the model.
# A key saved only in Cursor Settings → Models is not visible to this process.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Azure / compatible endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1

# Reproducibility
HARBORLINE_SEED=42

# Retrieval / chunking (deterministic; no random split)
HARBORLINE_CHUNK_SIZE=900
HARBORLINE_CHUNK_OVERLAP=120
HARBORLINE_TOP_K=5

# faiss (default, local MiniLM embeddings) or tfidf (no model download)
HARBORLINE_RETRIEVE_BACKEND=faiss
HARBORLINE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HARBORLINE_REWRITE=true
HARBORLINE_RERANK=true
HARBORLINE_FETCH_K=20
HARBORLINE_MIN_SCORE=0.22

# Leave unset to use llm when OPENAI_API_KEY is set, otherwise retrieve.
# Set retrieve to keep extractive templates even if a key is present.
# HARBORLINE_ANSWER_MODE=retrieve
